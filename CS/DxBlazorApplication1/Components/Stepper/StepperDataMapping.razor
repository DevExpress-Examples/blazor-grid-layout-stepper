@code {
    [CascadingParameter]
    private StepperDataMapping? DataMappings { get; set; }
    [Parameter]
    public string? Text { get; set; }
    [Parameter]
    public string? IconCssClass { get; set; }
    [Parameter]
    public string? Label { get; set; }

    protected override void OnInitialized() {
        DataMappings.Text = Text;
        DataMappings.Label = Label;
        DataMappings.IconCssClass = IconCssClass;
        DataMappings.DataMappingsInitialized?.Invoke(this, EventArgs.Empty);
    }

    public event EventHandler<EventArgs>? DataMappingsInitialized;
}
