@page "/recipe"
@rendermode InteractiveServer
@using DxBlazorApplication1.Components.Stepper
@using DxBlazorApplication1.Models

<style>
    .recipes {
        height: 500px;
        width: 500px;
    }

    .recipe-container {
        display: flex;
        height: 100%;
        align-items: center;
        justify-content: space-evenly;
    }

    .recipe-container > .stepper-html-root {
        height: 500px;
    }
</style>

<div class="recipe-container">
    <DxStepper Orientation=Orientation.Vertical Data="@Data"
               @bind-SelectedIndex="@SelectedIndex">
        <DataMappings>
            <StepperDataMapping Text="Text" Label="Label" IconCssClass="IconCssClass"></StepperDataMapping>
        </DataMappings>
    </DxStepper>

    <DxCarousel CssClass="recipes" @bind-ActiveItemIndex=SelectedIndex>
        <Items>
            <DxCarouselItem>
                <img src="/images/1.png" style="height:100%;" />
            </DxCarouselItem>
            <DxCarouselItem>
                <img src="/images/2.png" style="height:100%;" />
            </DxCarouselItem>
            <DxCarouselItem>
                <img src="/images/3.png" style="height:100%;" />
            </DxCarouselItem>
            <DxCarouselItem>
                <img src="/images/4.png" style="height:100%;" />
            </DxCarouselItem>
            <DxCarouselItem>
                <img src="/images/5.png" style="height:100%;" />
            </DxCarouselItem>
        </Items>
    </DxCarousel>
</div>

@code {
    public int SelectedIndex { get; set; }
    public List<StepperModel> Data { get; set; } = [];

    protected override void OnInitialized() {
        Data = new List<StepperModel>()
        {
            new StepperModel(){ Text = "1", Label = "Prepare ingredients", IconCssClass = "" },
            new StepperModel(){ Text = "2", Label = "Boil the pasta", IconCssClass= "" },
            new StepperModel(){ Text = "3", Label = "Make the sauce", IconCssClass = "" },
            new StepperModel(){ Text = "4", Label = "Combine pasta and sauce", IconCssClass = "" },
            new StepperModel(){ Text = "5", Label = "Serve the dish", IconCssClass = "" },
        };
    }
}

