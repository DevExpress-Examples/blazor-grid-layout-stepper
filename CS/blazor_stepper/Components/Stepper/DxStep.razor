@implements IDisposable
@code {
    private StepInfo _stepInfo = new();

    [CascadingParameter]
    private DxStepper? Stepper { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? IconCssClass { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized() {
        _stepInfo.Text = Text;
        _stepInfo.IconCssClass = IconCssClass;
        _stepInfo.Label = Label;
        _stepInfo.ChildContent = ChildContent;
        Stepper?.AddStep(_stepInfo);
    }

    public void Dispose()
    {
        Stepper?.RemoveStep(_stepInfo);
    }
}
